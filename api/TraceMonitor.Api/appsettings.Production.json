{
  "ConnectionStrings": {
    "PostgreSQL": "Host=YOUR_PG_HOST;Port=5432;Database=trace_monitor;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Prefer"
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_PRODUCTION_SECRET_AT_LEAST_32_CHARS_LONG",
    "Issuer": "TraceMonitor",
    "Audience": "TraceMonitor.UI",
    "ExpirationMinutes": 480
  },
  "Cors": {
    "AllowedOrigins": [
      "https://logs.yourdomain.com"
    ]
  },
  "UseHttpsRedirection": false
}
